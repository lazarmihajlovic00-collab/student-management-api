<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Definišemo putanju gde će se logovi čuvati unutar projekta -->
    <property name="LOGS" value="./logs" />

    <!-- 1. Konfiguracija za ispis u Konzoli (lep, obojen ispis dok razvijamo lokalno) -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <layout class="ch.qos.logback.classic.PatternLayout">
            <Pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n
            </Pattern>
        </layout>
    </appender>

    <!-- 2. Konfiguracija za upis u Fajl (Sve kategorije: INFO, WARN, ERROR) -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/application.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</Pattern>
        </encoder>

        <!-- Pravilo za rotaciju: Svaki dan se pravi novi fajl, a stari se arhiviraju -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/application-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory> <!-- Čuvamo logove najviše 30 dana -->
        </rollingPolicy>
    </appender>

    <!-- 3. Konfiguracija za isključiv upis Grešaka (Samo ERROR nivo ide ovde) -->
    <appender name="SevereRollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/errors.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</Pattern>
        </encoder>

        <!-- Filtriramo i puštamo samo ERROR poruke u ovaj fajl -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/errors-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Aktivacija pravila za celu aplikaciju -->
    <root level="INFO">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
        <appender-ref ref="SevereRollingFile" />
    </root>

</configuration>